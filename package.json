{
  "name": "packora-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "prisma generate",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
