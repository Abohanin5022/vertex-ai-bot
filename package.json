    "@tailwindcss/forms": "^0.5.11",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.40.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-pwa": "^5.6.0",
    "pdfkit": "^0.18.0",
    "prisma": "^7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.8.1",
